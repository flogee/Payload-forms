# Examples only. Prefer npm run setup:local for a new private random secret.
PAYLOAD_SECRET=replace-with-a-strong-random-local-secret
LOCAL_PROTOTYPE=0
SURVEY_ORIGIN=http://127.0.0.1:3212
DISABLE_SCHEMA_PUSH=0
MAIL_ENABLED=1
MAIL_LOCAL_TEST=1
MAIL_ORIGIN=http://127.0.0.1:3212
MAIL_FROM=forms@localhost.invalid
MAIL_ALLOWED_RECIPIENTS=notify@localhost.invalid,second@localhost.invalid
OPS_ALERT_RECIPIENT=notify@localhost.invalid
MAIL_MONTHLY_LIMIT=500
