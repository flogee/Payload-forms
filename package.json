{
  "name": "payload-forms",
  "version": "0.3.0",
  "description": "Self-hosted questionnaires, fictional pretests and gated real surveys with Payload CMS and Cloudflare",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/patch-payload-auth.mjs",
    "dev": "next dev --hostname 127.0.0.1 --port 3212",
    "build": "next build --webpack",
    "build:worker": "opennextjs-cloudflare build",
    "generate:types": "payload generate:types",
    "generate:worker-types": "wrangler types --env-interface CloudflareEnv --strict-vars=false cloudflare-env.d.ts",
    "generate:importmap": "payload generate:importmap",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:http": "node --import tsx tests/http-check.ts",
    "test:ci": "node scripts/ci-check.mjs",
    "preview:worker": "wrangler dev --port 3213 --ip 127.0.0.1 --var SURVEY_ORIGIN:http://127.0.0.1:3213",
    "export:instrument": "node --import tsx scripts/export-instrument.ts",
    "export:analysis-demo": "node --import tsx scripts/export-analysis-demo.ts",
    "migrate:create": "payload migrate:create",
    "setup:local": "node scripts/setup-install.mjs local",
    "setup:cloudflare": "node scripts/setup-install.mjs cloudflare",
    "doctor:local": "node scripts/doctor-install.mjs local",
    "doctor:cloudflare": "node scripts/doctor-install.mjs cloudflare",
    "build:cloudflare": "node scripts/install-command.mjs build",
    "migrate:cloudflare": "node scripts/install-command.mjs migrate",
    "bootstrap:cloudflare": "node scripts/install-command.mjs bootstrap",
    "release:cloudflare": "node scripts/release-internal.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.11.0",
    "@payloadcms/db-d1-sqlite": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/plugin-mcp": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-r2": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "cross-env": "10.1.0",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "jose": "6.2.12",
    "next": "16.3.8",
    "payload": "3.90.2",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-is": "19.3.0",
    "recharts": "3.10.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "24.12.3",
    "@types/pngjs": "6.0.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsqr": "1.4.0",
    "pngjs": "7.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "wrangler": "4.149.0"
  },
  "engines": {
    "node": ">=24.15.0",
    "pnpm": "^9 || ^10 || ^11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  },
  "author": "Florian Bauernfeind",
  "repository": {
    "type": "git",
    "url": "https://github.com/flogee/Payload-forms.git"
  },
  "homepage": "https://github.com/flogee/Payload-forms",
  "overrides": {
    "payload": {
      "undici": "7.29.1"
    },
    "monaco-editor": {
      "dompurify": "3.4.16"
    }
  }
}
